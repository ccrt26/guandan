            "asSuit": "S"
          }
        ]
      },
      "malformedDeclaration": {
        "kind": "pair",
        "cards": [
          {
            "id": 67,
            "suit": "S",
            "rank": 9
          },
          {
            "id": 7,
            "suit": "H",
            "rank": 2
          }
        ],
        "size": 2,
        "keyRank": 9,
        "length": 1,
        "pairRanks": [],
        "mainRank": 9,
        "wildAs": [
          {
            "cardId": 7,
            "asRank": 9,
            "asSuit": "S"
          }
        ]
      },
      "necessaryKeysEqual": true,
      "malformedMoveAccepted": true,
      "resultingEventPassesRootHistory": false,
      "historyError": "Error: history and current physical resources do not conserve the complete deal",
      "impact": "The strict legal-action ingress can emit public events whose card IDs claim the wrong physical suit/rank and whose wildcard annotation points to an actual non-wild card. The engine removes the owned IDs, but the preserved declaration is physically inconsistent and cannot be replayed by the newly added history guard. This compromises the claimed resource/declaration identity boundary.",
      "fixRecommendation": [
        "Before computing necessaryDeclarationKey, bind every selected card ID to its actual owned card and require its suit/rank attributes to match that physical card exactly.",
        "Validate wildcard annotation eligibility against those actual owned cards, not solely against caller-supplied card metadata. Keep the complete resource comparator and exact selected-output preservation for valid inputs.",
        "Add the independent swapped-ID/metadata red case and ensure rejection occurs before applyMove. Verify same-value duplicate-deck copies remain valid and distinct physical ownership is retained."
      ],
      "evidence": "/private/tmp/C2-match-foundation-engineering-002/identity-probe-output.json"
    }
