  "openFindings": [
    {
      "id": "C2-MATCH-E05",
      "severity": "P1",
      "status": "OPEN",
      "title": "Preserved selected cards are not individually bound to the owned physical ID attributes before effect comparison.",
      "location": {
        "path": "/Users/ccrt/game/guandan/lab/review6/match-play.ts",
        "line": 49,
        "reviewCopy": "/Users/ccrt/game/guandan/lab/review6_1/reviews/C2-match-foundation-002/source/lab/review6/match-play.ts"
      },
      "caseProvenance": "Constructed independent /private/tmp probe using a conserved108-card engine deal. This is not an original source incident or evidence that frozenChampion emitted this malformed declaration. No model was scored.",
      "reproduction": [
        "Place actual S9(id7) and wild H2(id67) in the acting hand, preserving the108-card deal. Classify the legal pair9: wildcard annotation refers to id67.",
        "Clone that combo, swap only its two cards IDs while retaining their suit/rank fields, and move the wildcard annotation reference to id7. The claimed resources remain the same suit/rank multiset and necessaryDeclarationKey remains identical.",
        "Run resolveLegalMove against the original owned cards: both IDs are owned, so it accepts and preserves the malformed selected combo. Apply that returned move in the temporary state; assertRootHistory rejects its newly emitted event because those ID/suit/rank tuples do not match buildDeck."
      ],
      "goodDeclaration": {
        "kind": "pair",
        "cards": [
          {
            "id": 7,
            "suit": "S",
            "rank": 9
          },
          {
            "id": 67,
