  "closedFindings": [
    {
      "id": "C2-MATCH-E05",
      "aliases": [
        "C2-MATCH-M01"
      ],
      "severity": "P1",
      "status": "CLOSED",
      "proof": "Replayed the exact independent002 swapped-ID/metadata case against frozen003. The necessary-effect keys still match, but resolveLegalMove rejects before applyMove with selected physical-card identity differs from the actual owned card. The valid-pair positive and original NN incident preservation regressions also pass.",
      "fixReviewed": "Each declared physical ID is looked up in the acting hand, then its suit/rank is bound to that actual owned card before necessary-effect comparison. Since the metadata now matches the actual owned card, wildcard eligibility cannot be forged by swapping attributes across genuinely owned IDs. Valid selected combo remains the original object."
    },
    {
      "id": "C2-MATCH-M02",
      "severity": "P1",
      "status": "CLOSED",
      "proof": "Replayed the original method-review owner witness (SHA95351a132039b6032fbf0d478ba26371b66cc40a0e1feb242025494a77c3c6bb): giftC-A#105 moved from recorded recipient0 to hidden seat1 is rejected, including when a contradictory owner subsequently plays it in an otherwise causal prefix.",
      "fixReviewed": "Initial post-exchange ownership is reconstructed from current hands plus all prior plays. Recorded returns and tributes are reversed in true reverse order with per-ID physical ownership checks. The frozen engine applyTribute and completeReturn then validate resistance, forced maximum tribute, giver/recipient/leader roles and recorded legal returns, and the resulting per-seat physical ownership must match. A private hand-order witness resolves legal highest-rank ties without treating that order as public information."
    }
  ],
