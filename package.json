{
  "name": "guandan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/ai && tsc --noEmit -p packages/review && tsc --noEmit -p packages/web",
    "sim": "tsx scripts/selfplay.ts",
    "dev": "node packages/web/server/index.mjs & vite dev packages/web --config packages/web/vite.config.ts",
    "dev:ui": "vite dev packages/web --config packages/web/vite.config.ts",
    "server": "node packages/web/server/index.mjs",
    "build": "vite build packages/web --config packages/web/vite.config.ts"
  },
  "devDependencies": {
    "@gd/ai": "0.1.0",
    "@gd/engine": "0.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
